map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream cryptory_api {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    # cryptory.duckdns.org is canonical. Keep the historical misspelled
    # crytory.duckdns.org alias so already-released clients continue to work.
    server_name cryptory.duckdns.org crytory.duckdns.org;

    location = /health {
        proxy_pass http://cryptory_api;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    location = /ready {
        proxy_pass http://cryptory_api;
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $request_id;
    }

    location /ws/ {
        proxy_pass http://cryptory_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }

    location / {
        proxy_pass http://cryptory_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Request-ID $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
