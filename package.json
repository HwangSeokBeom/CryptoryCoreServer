{
  "name": "crypto-mts-server",
  "version": "1.0.0",
  "description": "Cryptory Backend - Node.js + TypeScript + Fastify",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:clean": "bash scripts/dev-clean-port.sh",
    "dev:restart": "npm run dev:clean && npm run dev",
    "build": "tsc",
    "start": "node dist/index.js",
    "audit:production": "npm audit --omit=dev --omit=optional",
    "smoke:market-contract": "tsx scripts/smoke-market-contract.ts",
    "smoke:market-sparkline-coverage": "tsx scripts/smoke-market-sparkline-coverage.ts",
    "smoke:market-sparkline-coverage:prod": "node scripts/smoke-market-sparkline-coverage.js",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/websocket": "^11.3.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^5.4.1",
    "node-cron": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "ws": "^8.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "eslint": "^10.7.0",
    "tsx": "^4.19.2",
    "typescript-eslint": "^8.65.0",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
